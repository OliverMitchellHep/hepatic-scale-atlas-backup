---
/**
 * Rex Hepatis title page. Standalone page (not a Starlight doc): white ground, navy ink. Layout from the approved comp
 * (.impeccable/mocks/gray/comp.html); the frontispiece is now a live preview of the atlas (the atlas itself in #preview
 * mode in an iframe, desktop only; phones and reduced motion get the poster, img/atlas-preview.webp).
 * The scale rule links into the atlas at each scale (same #v= share format as AtlasLink).
 * Header: the shared logo and site tabs; the hero leads with one large Launch button.
 */
import Logo from '../components/Logo.astro';
import SiteNav from '../components/SiteNav.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const atlas = (z: number) => `${base}/atlas/#v=${Buffer.from(JSON.stringify({ v: 1, z }), 'utf8').toString('base64url')}`;
const scales = [['Organ', 0], ['Lobule', 1], ['Acinus', 2], ['Sinusoid', 3], ['Hepatocyte', 4]] as const;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rex Hepatis</title>
  <meta name="description" content="An interactive 3D teaching model of the liver and hepatobiliary system, from the whole organ to the individual hepatocyte, for hepatology trainees and consultants." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,600;0,6..72,700;1,6..72,400&family=IBM+Plex+Sans:wght@400;500&display=swap" />
  <style>
    :root { --ground:#FFFFFF; --navy:#0E1A2E; --ink-2:#4A5872; --rule:#D5DCE8; --acc:#2C6DBA; --serif:"Newsreader",Georgia,serif; }
    *{box-sizing:border-box}
    html,body{margin:0}
    body{background:var(--ground);color:var(--navy);font-family:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;-webkit-font-smoothing:antialiased}
    ::selection{background:#CFE0F5;color:var(--navy)}
    a{color:inherit}
    a:focus-visible{outline:2px solid var(--acc);outline-offset:3px;border-radius:2px}
    .page{min-height:100vh;display:flex;flex-direction:column;padding:0 clamp(20px,4.5vw,64px)}
    .head{display:flex;justify-content:space-between;align-items:flex-end;gap:24px;padding:22px 0 0;border-bottom:1px solid var(--navy)}
    .head :global(.rh-logo){margin-bottom:12px;--rh-logo-size:50px}
    main{flex:1;display:grid;grid-template-columns:minmax(300px,5fr) 7fr;gap:clamp(32px,4.5vw,72px);align-items:center;padding:40px 0}
    .sr-only{position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}
    .lede{font-size:17.5px;line-height:1.55;color:var(--ink-2);margin:0 0 22px;max-width:42ch}
    .launch{display:flex;align-items:center;justify-content:space-between;gap:24px;max-width:560px;margin:0 0 28px;padding:30px 34px;border-radius:4px;background:var(--navy);color:#fff;text-decoration:none;box-shadow:0 14px 34px -18px rgba(14,26,46,.55);transition:background .15s,transform .15s,box-shadow .15s}
    .launch b{font:600 clamp(28px,2.9vw,38px)/1.05 var(--serif);letter-spacing:-.01em;font-variation-settings:"opsz" 60;white-space:nowrap}
    .launch svg{flex:none;width:40px;height:40px;transition:transform .15s}
    .launch:hover{background:#1B2E4D;transform:translateY(-2px);box-shadow:0 18px 38px -18px rgba(14,26,46,.7)}
    .launch:hover svg{transform:translateX(4px)}
    .launch:focus-visible{outline:2px solid var(--acc);outline-offset:3px}
    figure{margin:0}
    /* atlas preview card: the size of the plate it replaces (650 × 436), black stage in a navy frame; the whole card opens the atlas */
    .preview{position:relative;display:block;aspect-ratio:650/436;overflow:hidden;border-radius:4px;background:#07090B;border:1px solid var(--navy);box-shadow:0 0 0 4px var(--navy),0 18px 40px -20px rgba(14,26,46,.6);transition:transform .15s,box-shadow .15s}
    .preview:hover{transform:translateY(-2px);box-shadow:0 0 0 4px #1B2E4D,0 22px 44px -20px rgba(14,26,46,.75)}
    .preview:focus-visible{outline:2px solid var(--acc);outline-offset:7px}
    .preview img,.preview :global(iframe){position:absolute;inset:0;display:block;width:100%;height:100%;border:0}
    .preview img{object-fit:cover}
    .preview :global(iframe){pointer-events:none;opacity:0;transition:opacity .6s}
    .preview.live :global(iframe){opacity:1}
    figcaption{font:italic 400 15px/1.4 var(--serif);color:var(--ink-2);margin-top:8px}
    figcaption b{font-style:normal;font-variant:small-caps;letter-spacing:.06em;color:var(--navy);font-weight:600}
    .scale{list-style:none;margin:44px 0 0;padding:14px 0 0;border-top:1px solid var(--navy);display:flex;justify-content:space-between;gap:8px}
    .scale a{position:relative;display:block;padding:10px 4px 2px;font:italic 400 17px var(--serif);text-decoration:none;text-align:center}
    .scale a::before{content:"";position:absolute;left:50%;top:-15px;width:1px;height:11px;background:var(--navy);transition:height .15s,background .15s}
    .scale a:hover{color:var(--acc)}
    .scale a:hover::before{background:var(--acc);height:15px}
    .scale li:first-child a{color:var(--acc)}
    .scale li:first-child a::before{background:var(--acc);width:2px;height:15px}
    .scale-hint{font-size:12.5px;color:var(--ink-2);margin:10px 0 0;text-align:right}
    .foot{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px 24px;padding:0 0 30px;font-size:12.5px;color:var(--ink-2)}
    .foot a{text-decoration:underline;text-decoration-color:var(--rule);text-underline-offset:4px}
    .foot a:hover{color:var(--navy);text-decoration-color:var(--navy)}
    @media (max-width:900px){
      main{grid-template-columns:1fr;gap:28px;padding:28px 0 32px}
      .head{flex-direction:column;align-items:flex-start;gap:14px}
      .head :global(.rh-logo){--rh-logo-size:42px;margin-bottom:0}
      .head{gap:6px}
      .launch{max-width:none;padding:22px 24px}
      .launch b{font-size:26px}
      .lede{max-width:none}
      .scale{margin-top:32px;flex-wrap:wrap;justify-content:flex-start;gap:4px 18px}
      .scale a::before{display:none}
      .scale li:first-child a{color:var(--acc)}
      .scale-hint{text-align:left}
    }
  </style>
</head>
<body>
  <div class="page">
    <header class="head">
      <Logo />
      <SiteNav />
    </header>
    <main>
      <div>
        <h1 class="sr-only">Rex Hepatis: the liver, from organ to hepatocyte</h1>
        <a class="launch" href={`${base}/atlas/`}><b>Launch liver atlas</b><svg viewBox="0 0 40 40" aria-hidden="true"><circle cx="20" cy="20" r="19" fill="none" stroke="currentColor" stroke-opacity=".45" stroke-width="1.5"/><path d="M13 20h13M21 14l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg></a>
        <p class="lede">An interactive 3D teaching model of the liver and hepatobiliary system</p>
      </div>
      <div>
        <figure>
          <a class="preview" id="atlas-preview" href={`${base}/atlas/`} data-src={`${base}/atlas/#preview`} aria-label="Open the liver atlas">
            <img src={`${base}/img/atlas-preview.webp`} width="1300" height="872" alt="The 3D liver atlas: portal, arterial and hepatic venous trees and the biliary tree inside a ghosted liver, with the neighbouring organs ghosted." />
          </a>
          <figcaption><b>Fig. 1.</b> The atlas: vessels and biliary tree in a ghosted liver, with blood flowing.</figcaption>
        </figure>
        <ol class="scale" aria-label="Open the atlas at a scale">
          {scales.map(([name, z]) => <li><a href={atlas(z)}>{name}</a></li>)}
        </ol>
        <p class="scale-hint">Open the atlas at any scale, from the whole organ down to the hepatocyte.</p>
      </div>
    </main>
    <footer class="foot"><span>Illustrative teaching model. Not for clinical decisions.</span><a href={`${base}/about/`}>About</a></footer>
  </div>
  <script is:inline>
  /* Live atlas preview (desktop): the atlas in #preview mode in an iframe, created once the page has loaded and the card
     is near the viewport; the poster stays until the atlas reports ready. Paused off screen and in a hidden tab.
     Phones, touch-first screens and reduced motion keep the poster and never start WebGL. */
  (() => {
    const card = document.getElementById('atlas-preview');
    if (!card || !('IntersectionObserver' in window)) return;
    if (!matchMedia('(min-width: 901px) and (hover: hover) and (pointer: fine)').matches || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    let frame = null, seen = false;
    const post = (m) => { if (frame && frame.contentWindow) frame.contentWindow.postMessage({ rhPreview: m }, location.origin); };
    const sync = () => post(seen && !document.hidden ? 'play' : 'pause');
    const start = () => {
      frame = document.createElement('iframe');
      frame.src = card.dataset.src; frame.title = 'Atlas preview'; frame.tabIndex = -1; frame.setAttribute('aria-hidden', 'true');
      card.appendChild(frame);
    };
    addEventListener('message', (e) => {
      if (e.origin !== location.origin || !frame || e.source !== frame.contentWindow || !e.data) return;
      if (e.data.rhPreview === 'ready') { card.classList.add('live'); sync(); }
    });
    const io = new IntersectionObserver((es) => {
      seen = es[es.length - 1].isIntersecting;
      if (seen && !frame) { (window.requestIdleCallback || setTimeout)(start, { timeout: 1500 }); return; }
      sync();
    }, { rootMargin: '200px' });
    const go = () => io.observe(card);
    document.addEventListener('visibilitychange', sync);
    card.addEventListener('click', () => post('pause'));   // free the main thread for the navigation into the full atlas
    if (document.readyState === 'complete') go(); else addEventListener('load', go, { once: true });
  })();
  </script>
</body>
</html>
