---
/**
 * The Rex Hepatis logo: the Newsreader 700 wordmark with the gold crown seated upright on the R. The one logo
 * component: the title page, the docs header (Header.astro) and the atlas page (pages/atlas/index.astro) all
 * render it, and it always links to the home page.
 *
 * Crown placement: the crown is slung over the R's top-left corner, tilted 38° anticlockwise, its left base corner
 * resting on the vertical stem and its right base corner on the horizontal top of the R. From Newsreader 700 (opsz 48)
 * glyph metrics at line-height 1: the R's top edge is at 0.04em below the line box (flat from x 0.03 to 0.45em) and the
 * stem's left edge is vertical at x 0.1075em from 0.09 to 0.68em down. The crown (0.58em wide; base corners at x 5.7
 * and 54.3, y 37 of its 60 × 40 viewBox) is rotated about its left base corner, which sits on the stem at 0.329em down;
 * the rotation brings the right base corner to the top edge at x 0.478em. The crown is drawn after the text (on top).
 * padding makes room for the tilted crown (its pearls reach 0.18em above and 0.07em left of the letter's box).
 *
 * size: font size of the wordmark (any CSS length); the crown scales with it.
 */
import Crown from './Crown.astro';
interface Props { size?: string; class?: string }
const { size, class: cls } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<a class:list={['rh-logo', cls]} href={`${base}/`} style={size ? `--rh-logo-size:${size}` : undefined} aria-label="Rex Hepatis, home">Rex Hepatis<Crown /></a>
<style is:inline>
.rh-logo{position:relative;display:inline-block;padding:.19em 0 0 .07em;font:700 var(--rh-logo-size,50px)/1 "Newsreader",Georgia,serif;font-variation-settings:"opsz" 48;letter-spacing:-.005em;color:inherit;text-decoration:none;white-space:nowrap}
.rh-logo .crown{position:absolute;z-index:1;left:.1224em;top:.1615em;width:.58em;height:.3867em;transform:rotate(-38deg);transform-origin:9.5% 92.5%;pointer-events:none;filter:drop-shadow(0 .02em .02em rgba(14,26,46,.25))}
</style>
